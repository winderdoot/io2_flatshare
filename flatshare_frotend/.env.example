# ─── Konfiguracja backendu ────────────────────────────────────────────────────
#
# VITE_BACKEND_TYPE – Wybór backendu: "team1" (własny) lub "team2" (drugi zespół).
#
# ── Własny backend (io2_flatshare) ───────────────────────────────────────────
# VITE_API_URL=http://localhost:7047
# VITE_BACKEND_TYPE=team1
# (VITE_PROXY_TARGET nie jest potrzebny)
#
# ── Backend drugiego zespołu (projekt_2) ─────────────────────────────────────
# Przy team2 API_URL musi być pusty — Vite proxy przekierowuje /api → VITE_PROXY_TARGET
# VITE_API_URL=
# VITE_BACKEND_TYPE=team2
# VITE_PROXY_TARGET=http://localhost:5282

VITE_API_URL=http://localhost:7047
VITE_BACKEND_TYPE=team1
